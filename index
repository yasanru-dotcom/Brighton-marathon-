]],
["29 Mar–4 Apr","~45–55 km incl. race","Race week",[
"6–8 km easy.",
"8–10 km total including 3 × 1 km at MP; easy recoveries.",
"6–8 km easy.",
"5–6 km easy + 4 short relaxed strides.",
"Rest; prepare kit and fuelling.",
"15–20 min shakeout or rest.",
"RACE DAY: Brighton Marathon, 42.2 km. Goal 3:15; average pace 4:37/km. Start controlled and fuel early."
]]
];

const days=["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"];
const select=document.getElementById("week");
weeks.forEach((w,i)=>{
 const o=document.createElement("option");
 o.value=i;o.textContent=`Week ${i+1} · ${w[0]}`;select.appendChild(o);
});
let done={};
try{done=JSON.parse(localStorage.getItem("brighton315progress")||"{}")||{};}catch(e){done={};}
function save(){
 try{localStorage.setItem("brighton315progress",JSON.stringify(done));}catch(e){}
 updateProgress();
}
function updateProgress(){
 const count=Object.values(done).filter(Boolean).length;
 const total=weeks.length*7;
 document.getElementById("bar").style.width=(100*count/total)+"%";
 document.getElementById("progressText").textContent=
 `${count} of ${total} daily entries completed (${Math.round(100*count/total)}%)`;
}
function render(){
 const i=Number(select.value),w=weeks[i];
 const plan=document.getElementById("plan");
 const dayHtml=w[3].map((text,j)=>{
  const key=`${i}-${j}`,checked=!!done[key];
  return `<div class="day ${checked?"done":""}">
  <input type="checkbox" data-key="${key}" ${checked?"checked":""} aria-label="Complete ${days[j]}">
  <div><div class="dayname">${days[j]}${i===21&&j===6?" · RACE DAY":""}</div>
  <div class="detail">${text}</div></div></div>`;
 }).join("");
 plan.innerHTML=`<section class="card">
 <div class="weekhead"><div><h2>Week ${i+1} · ${w[0]}</h2><div class="small">${w[2]}</div></div>
 <div class="target">${w[1]}</div></div>
 <div class="days">${dayHtml}</div></section>`;
 plan.querySelectorAll("input").forEach(cb=>{
  cb.addEventListener("change",()=>{
   if(cb.checked)done[cb.dataset.key]=true;
   else delete done[cb.dataset.key];
   save();render();
  });
 });
}
select.addEventListener("change",render);
document.getElementById("current").addEventListener("click",()=>{
 const start=new Date("2026-11-02T00:00:00");
 const now=new Date();
 let i=Math.floor((now-start)/(7*86400000));
 i=Math.max(0,Math.min(21,i));
 select.value=i;render();
});
document.getElementById("export").addEventListener("click",()=>{
 const blob=new Blob([JSON.stringify({app:"Brighton 3:15 plan",done},null,2)],{type:"application/json"});
 const url=URL.createObjectURL(blob);
 const a=document.createElement("a");a.href=url;
 a.download="brighton-marathon-progress.json";a.click();
 URL.revokeObjectURL(url);
});
document.getElementById("import").addEventListener("click",()=>document.getElementById("file").click());
document.getElementById("file").addEventListener("change",async e=>{
 const f=e.target.files[0];if(!f)return;
 try{
  const data=JSON.parse(await f.text());
  if(!data.done||typeof data.done!=="object")throw Error();
  done=data.done;save();render();alert("Progress imported.");
 }catch(err){alert("Invalid backup file. Choose a JSON backup from this app.");}
 e.target.value="";
});
render();updateProgress();
</script>
</body>
</html>
